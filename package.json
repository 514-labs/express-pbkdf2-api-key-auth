{
  "name": "express-pbkdf2-api-key-auth",
  "version": "1.0.0",
  "description": "Express middleware for PBKDF2 API key authentication",
  "license": "ISC",
  "author": "",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "test": "tsc -p tsconfig.test.json && node --test dist/test/index.test.js"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "express": "^4.18.2",
    "typescript": "^5.9.3"
  }
}
